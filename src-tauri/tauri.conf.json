{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engine",
  "version": "0.1.0",
  "identifier": "com.engine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Engine",
        "width": 720,
        "height": 560,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0B0B0D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}