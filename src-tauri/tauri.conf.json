{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engine",
  "version": "../package.json",
  "identifier": "com.engine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Engine",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0E0C15",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNDc3ODZGRjlGQjlBNEIKUldSTG12djViM2hIU3ZWRjUxY3BFOHRDdSszaHZNMUFxV3FzS3ZZelVWbjFvbnJzYmZkcm4xMTcK",
      "endpoints": [
        "https://github.com/neelsatish/engine/releases/latest/download/latest.json"
      ]
    }
  }
}
